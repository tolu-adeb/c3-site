{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c3.site/schemas/v1/monthly.schema.json",
  "title": "c3.site monthly",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "month": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
      },
      "trades": {
        "type": "integer",
        "minimum": 0
      },
      "win_rate": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "net_r": {
        "type": "number"
      },
      "net_usd": {
        "type": "number"
      }
    },
    "required": [
      "month",
      "trades",
      "win_rate",
      "net_r",
      "net_usd"
    ],
    "additionalProperties": false
  }
}
