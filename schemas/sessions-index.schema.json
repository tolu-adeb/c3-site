{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c3.site/schemas/v1/sessions-index.schema.json",
  "title": "c3.site sessions-index",
  "description": "Chronological tested sessions; has_bars declares whether a replay file exists.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "format": "date"
      },
      "n_trades": {
        "type": "integer",
        "minimum": 0
      },
      "net_r": {
        "type": "number"
      },
      "has_bars": {
        "type": "boolean"
      },
      "tags": {
        "$ref": "common.schema.json#/$defs/strings"
      }
    },
    "required": [
      "date",
      "n_trades",
      "net_r",
      "has_bars",
      "tags"
    ],
    "additionalProperties": false
  }
}
