    {
      "dot": "cyan",
      "title": "What the redesign changed",
      "items": [
        "Home tells how an alert is made in five steps; one inline SVG session chart gains a layer per step",
        "A section rail shows progress; a numbered tile menu and a Display panel are on every page",
        "Theme and motion choices are saved in the browser; theme.js applies them before the page paints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Weight and privacy",
      "items": [
        "Home is about 104 KB with no third-party requests; the Archivo font is served from the site",
        "The CSP allows only the site itself for scripts, styles, fonts and connections",
        "Every text and chart layer shows without JavaScript; there is no loading screen"
      ]
    },
    {
      "dot": "amber",
      "title": "Next (proposed)",
      "items": [
        "Phase 2: a methodology page, a monthly chart on the track record, 320 px and accessibility checks",
        "The private dashboard is unchanged in behaviour; it shares the tokens and type"
      ]
    }
