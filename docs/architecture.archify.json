  "cards": [
    {
      "dot": "rose",
      "title": "Who can do what",
      "items": [
        "Anyone: the public pages, the waitlist form and the public track record",
        "Your private link: the dashboard data and the waitlist; the key rides in the #fragment, then an Authorization header",
        "The bot: pushes and command pulls, each signed with its Ed25519 key; the site holds only the public key",
        "Commands queue here, but the bot runs one only if its HMAC matches the control code, which the site never sees"
      ]
    },
    {
      "dot": "cyan",
      "title": "What D1 keeps",
      "items": [
        "Latest status, snapshot and paper results from the bot, plus one heartbeat row a minute for session coverage",
        "Waitlist signups (email, optional note) and hashed signup attempts for the 5-an-hour limit",
        "Commands with their status and result; front-door webhooks as exact text, duplicates flagged",
        "The daily cron drops heartbeats after 45 days, attempts after 2 and commands after 60"
      ]
    },
    {
      "dot": "amber",
      "title": "Switches",
      "items": [
        "TRACK_RECORD_PUBLIC is on: the public page shows paper trades since the bot's ABG_SITE_TRACK_FROM",
        "WEBHOOK_ENABLED is off until the receiver design is agreed with khuovi; when on it checks path, token and TradingView's IPs",
        "Per-request logs are off so the webhook's secret path never reaches logs"
      ]
    }
  ]
